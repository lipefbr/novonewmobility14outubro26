// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                String   @id @default(cuid())
  email             String   @unique
  name              String
  username          String?  @unique
  phone             String?
  cpf               String?  @unique
  password          String
  role              String   @default("user")
  isActive          Boolean  @default(false)
  plan              String   @default("free")
  language          String   @default("pt")
  
  // Referral system
  referralCode      String   @unique
  referredById      String?
  
  // Matrix positions
  entradaLevel      Int      @default(0)
  residualLevel     Int      @default(0)
  vendasLevel       Int      @default(0)
  
  // Balances (in cents to avoid floating point)
  balanceWithdrawal     Int    @default(0)
  balanceMobility       Int    @default(0)
  balanceShopping       Int    @default(0)
  balanceFood           Int    @default(0)
  balancePharmacy       Int    @default(0)
  balanceGratification  Int    @default(0)
  balanceFree           Int    @default(0)
  balancePending        Int    @default(0)

  // User type
  userType          String   @default("usuario")
  
  // Points
  careerPoints      Int      @default(0)
  personalPoints    Int      @default(0)
  stars             Int      @default(0)
  
  // Driver-specific
  isDriver          Boolean  @default(false)
  isDelivery        Boolean  @default(false)
  totalRides        Int      @default(0)
  
  // Metadata
  profileImage      String?
  address           String?
  city              String?
  state             String?
  country           String?  @default("BR")
  bankCode          String?
  bankAgency        String?
  bankAccount       String?
  bankType          String?
  pixKey            String?
  pixEnabled        Boolean  @default(true)
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  // Relations
  cashbackEntries      CashbackEntry[]
  cashbackResiduals    CashbackResidual[]
  cashbackSales        CashbackSales[]
  transactions         Transaction[]
  vouchers             Voucher[]
  tickets              Ticket[]
  ticketMessages       TicketMessage[]
  notifications        Notification[]
  invoices             Invoice[]
  careerMilestones     CareerMilestone[]
  matrixPositions      MatrixPosition[]
  gratifications       Gratification[]
  pointTransactions    PointTransaction[]
  gamificationStreak   GamificationStreak?
  userChallenges       UserChallenge[]
  marketplaceOrders    MarketplaceOrder[]
  marketplaceOrderItems MarketplaceOrderItem[]
  beneficiaries        Beneficiary[]
  bets                 Bet[]
  referrals            User[]               @relation("Referrals")
  referredBy           User?                @relation("Referrals", fields: [referredById], references: [id])
}

model Bet {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  eventId         String
  eventLabel      String
  selection       String
  selectionLabel  String
  odds            Float
  amountInCents   Int
  potentialWinInCents Int
  status          String   @default("pending")
  result          String?
  settledAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model MatrixPosition {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  matrixType      String
  parentId        String?
  level           Int      @default(0)
  position        Int      @default(0)
  isFilled        Boolean  @default(true)
  createdAt       DateTime @default(now())
}

model CashbackEntry {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  fromUserId      String
  amount          Int
  level           Int
  percentage      Float
  description     String?
  createdAt       DateTime @default(now())
}

model CashbackResidual {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  fromUserId      String
  amount          Int
  level           Int
  percentage      Float
  description     String?
  createdAt       DateTime @default(now())
}

model CashbackSales {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  fromUserId      String
  amount          Int
  level           Int
  percentage      Float
  category        String
  description     String?
  createdAt       DateTime @default(now())
}

model Transaction {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  type            String
  amount          Int
  status          String   @default("pending")
  category        String?
  description     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Invoice {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  amount          Int
  type            String
  status          String   @default("pending")
  dueDate         DateTime
  paidAt          DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Voucher {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  code            String   @unique
  amount          Int
  type            String
  isUsed          Boolean  @default(false)
  usedAt          DateTime?
  expiresAt       DateTime?
  createdAt       DateTime @default(now())
}

model Ticket {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  subject         String
  category        String
  status          String   @default("open")
  priority        String   @default("normal")
  messages        TicketMessage[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model TicketMessage {
  id              String   @id @default(cuid())
  ticketId        String
  ticket          Ticket   @relation(fields: [ticketId], references: [id])
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  message         String
  isAdmin         Boolean  @default(false)
  attachments     String?
  createdAt       DateTime @default(now())
}

model Notification {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  title           String
  message         String
  type            String
  isRead          Boolean  @default(false)
  createdAt       DateTime @default(now())
}

model CareerMilestone {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  milestone       String
  pointsRequired  Int
  achieved        Boolean  @default(false)
  achievedAt      DateTime?
  createdAt       DateTime @default(now())
}

model Gratification {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  type            String
  amount          Int
  category        String
  description     String?
  isClaimed       Boolean  @default(false)
  claimedAt       DateTime?
  createdAt       DateTime @default(now())
}

model PointTransaction {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  amount          Int
  type            String
  description     String?
  referenceId     String?
  createdAt       DateTime @default(now())
}

model SystemConfig {
  id              String   @id @default(cuid())
  key             String   @unique
  value           String
  description     String?
  updatedAt       DateTime @updatedAt
}

model Announcement {
  id              String   @id @default(cuid())
  title           String
  message         String
  type            String   @default("info")
  priority        String   @default("normal")
  isActive        Boolean  @default(true)
  startDate       DateTime?
  endDate         DateTime?
  actionLabel     String?
  actionUrl       String?
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model GamificationStreak {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id])
  currentStreak   Int      @default(0)
  longestStreak   Int      @default(0)
  lastLoginDate   DateTime?
  totalPoints     Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Challenge {
  id              String   @id @default(cuid())
  title           String
  description     String
  type            String
  targetValue     Int
  rewardPoints    Int
  isActive        Boolean  @default(true)
  startDate       DateTime?
  endDate         DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  userChallenges  UserChallenge[]
}

model UserChallenge {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  challengeId     String
  challenge       Challenge @relation(fields: [challengeId], references: [id])
  currentValue    Int      @default(0)
  completed       Boolean  @default(false)
  completedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Event {
  id              String   @id @default(cuid())
  title           String
  description     String
  type            String
  status          String   @default("upcoming")
  eventDate       DateTime
  endDate         DateTime?
  location        String?
  meetingUrl      String?
  maxAttendees    Int?
  imageUrl        String?
  isActive        Boolean  @default(true)
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  registrations   EventRegistration[]
}

model EventRegistration {
  id              String   @id @default(cuid())
  eventId         String
  event           Event    @relation(fields: [eventId], references: [id])
  userId          String
  registeredAt    DateTime @default(now())

  @@unique([eventId, userId])
}

model Beneficiary {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  name         String
  cpf          String?
  relationship String
  percentage   Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model MarketplaceProduct {
  id              String   @id @default(cuid())
  name            String
  description     String?
  price           Int
  originalPrice   Int?
  category        String
  imageUrl        String?
  images          String?
  stock           Int      @default(0)
  isActive        Boolean  @default(true)
  isFeatured      Boolean  @default(false)
  cashbackPercent Float    @default(0)
  rating          Float    @default(0)
  reviewCount     Int      @default(0)
  sellerName      String?
  tags            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  orderItems      MarketplaceOrderItem[]
}

model MarketplaceOrder {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  status          String   @default("pending")
  totalAmount     Int
  cashbackEarned  Int      @default(0)
  shippingAddress String?
  paymentMethod   String?
  paidAt          DateTime?
  shippedAt       DateTime?
  deliveredAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  items           MarketplaceOrderItem[]
}

model MarketplaceOrderItem {
  id              String   @id @default(cuid())
  orderId         String
  order           MarketplaceOrder @relation(fields: [orderId], references: [id])
  productId       String
  product         MarketplaceProduct @relation(fields: [productId], references: [id])
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  productName     String
  quantity        Int      @default(1)
  unitPrice       Int
  cashbackPercent Float    @default(0)
  createdAt       DateTime @default(now())
}
