generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                 @id @default(cuid())
  email                 String                 @unique
  name                  String
  username              String?                @unique
  phone                 String?
  cpf                   String?                @unique
  password              String
  role                  String                 @default("user")
  isActive              Boolean                @default(false)
  plan                  String                 @default("free")
  language              String                 @default("pt")
  referralCode          String                 @unique
  referredById          String?
  entradaLevel          Int                    @default(0)
  residualLevel         Int                    @default(0)
  vendasLevel           Int                    @default(0)
  balanceWithdrawal     Int                    @default(0)
  balanceMobility       Int                    @default(0)
  balanceShopping       Int                    @default(0)
  balanceFood           Int                    @default(0)
  balancePharmacy       Int                    @default(0)
  balanceGratification  Int                    @default(0)
  balancePaymentInvoice Int                    @default(0)
  careerPoints          Int                    @default(0)
  personalPoints        Int                    @default(0)
  stars                 Int                    @default(0)
  isDriver              Boolean                @default(false)
  isDelivery            Boolean                @default(false)
  totalRides            Int                    @default(0)
  profileImage          String?
  address               String?
  city                  String?
  state                 String?
  country               String?                @default("BR")
  bankCode              String?
  bankAgency            String?
  bankAccount           String?
  bankType              String?
  pixKey                String?
  pixEnabled            Boolean                @default(true)
  // User opt-in to automatic monthly fee debit. When enabled, the system
  // will attempt to deduct the monthly fee (R$999,90 for Premium 5) from
  // the user's internal balances on the due date. If no balance is
  // available, the user is prompted to transfer from another internal
  // wallet (see My Plan page helper text).
  autoDebitEnabled      Boolean                @default(false)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  balanceFree           Int                    @default(0)
  balancePending        Int                    @default(0)
  userType              String                 @default("usuario")
  planId                String?
  // Personal data fields
  birthDate             DateTime?
  rg                    String?
  maritalStatus         String?
  gender                String?
  education             String?
  zipCode               String?
  sponsorId             String?
  qualification         String?
  // Emergency contact
  emergencyName         String?
  emergencyPhone        String?
  emergencyRelation     String?
  // Asaas payment gateway integration
  asaasCustomerId       String?
  asaasWalletId         String?
  // KYC verification (Task 14-A / 16-A)
  kycStatus             String?  // 'none' | 'pending' | 'approved' | 'rejected'
  kycVerifiedAt         DateTime?
  kycVerifiedById       String?
  kycRejectedReason     String?
  kycDocuments          KycDocument[]
  auditLogs             AuditLog[]
  telemedicinaRequests  TelemedicinaRequest[]
  beneficiaries         Beneficiary[]
  bets                  Bet[]
  careerMilestones      CareerMilestone[]
  cashbackEntries       CashbackEntry[]
  cashbackResiduals     CashbackResidual[]
  cashbackSales         CashbackSales[]
  gamificationStreak    GamificationStreak?
  gratifications        Gratification[]
  invoices              Invoice[]
  marketplaceOrders     MarketplaceOrder[]
  marketplaceOrderItems MarketplaceOrderItem[]
  matrixPositions       MatrixPosition[]
  notifications         Notification[]
  pointTransactions     PointTransaction[]
  tickets               Ticket[]
  ticketMessages        TicketMessage[]
  transactions          Transaction[]
  Plan                  Plan?                  @relation(fields: [planId], references: [id])
  referredBy            User?                  @relation("Referrals", fields: [referredById], references: [id])
  referrals             User[]                 @relation("Referrals")
  userChallenges        UserChallenge[]
  vouchers              Voucher[]
  withdrawalRequests    WithdrawalRequest[]
}

model Bet {
  id                  String    @id @default(cuid())
  userId              String
  eventId             String
  eventLabel          String
  selection           String
  selectionLabel      String
  odds                Float
  amountInCents       Int
  potentialWinInCents Int
  status              String    @default("pending")
  result              String?
  settledAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  user                User      @relation(fields: [userId], references: [id])
}

model MatrixPosition {
  id         String   @id @default(cuid())
  userId     String
  matrixType String
  parentId   String?
  level      Int      @default(0)
  position   Int      @default(0)
  isFilled   Boolean  @default(true)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
}

model CashbackEntry {
  id          String   @id @default(cuid())
  userId      String
  fromUserId  String
  amount      Int
  level       Int
  percentage  Float
  description String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
}

model CashbackResidual {
  id          String   @id @default(cuid())
  userId      String
  fromUserId  String
  amount      Int
  level       Int
  percentage  Float
  description String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
}

model CashbackSales {
  id          String   @id @default(cuid())
  userId      String
  fromUserId  String
  amount      Int
  level       Int
  percentage  Float
  category    String
  description String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
}

model Transaction {
  id          String   @id @default(cuid())
  userId      String
  type        String
  amount      Int
  status      String   @default("pending")
  category    String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id])
}

model Invoice {
  id              String    @id @default(cuid())
  userId          String
  amount          Int
  type            String
  status          String    @default("pending")
  dueDate         DateTime
  paidAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id])
  // Asaas payment integration fields
  asaasPaymentId  String?
  paymentMethod   String?   // 'pix' | 'boleto' | 'credit_card'
  invoiceUrl      String?   // Asaas invoice URL
  bankSlipUrl     String?   // Boleto PDF URL
  pixCode         String?   // PIX copy-and-paste code
  pixQrCode       String?   // PIX QR code image (base64 or URL)
  description     String?
}

model Voucher {
  id        String    @id @default(cuid())
  userId    String
  code      String    @unique
  amount    Int
  type      String
  isUsed    Boolean   @default(false)
  usedAt    DateTime?
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])
}

model Ticket {
  id        String          @id @default(cuid())
  userId    String
  subject   String
  category  String
  status    String          @default("open")
  priority  String          @default("normal")
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  user      User            @relation(fields: [userId], references: [id])
  messages  TicketMessage[]
}

model TicketMessage {
  id          String   @id @default(cuid())
  ticketId    String
  userId      String
  message     String
  isAdmin     Boolean  @default(false)
  attachments String?
  createdAt   DateTime @default(now())
  ticket      Ticket   @relation(fields: [ticketId], references: [id])
  user        User     @relation(fields: [userId], references: [id])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model CareerMilestone {
  id             String    @id @default(cuid())
  userId         String
  milestone      String
  pointsRequired Int
  achieved       Boolean   @default(false)
  achievedAt     DateTime?
  createdAt      DateTime  @default(now())
  user           User      @relation(fields: [userId], references: [id])
}

model Gratification {
  id           String    @id @default(cuid())
  userId       String
  type         String
  amount       Int
  category     String
  description  String?
  isClaimed    Boolean   @default(false)
  claimedAt    DateTime?
  createdAt    DateTime  @default(now())
  // New client-spec §5 fields for richer gratification tracking.
  // - frequency: 'one_time' | 'monthly' | 'daily' (default 'one_time').
  //   Only "Pagamento de Faturas" is recurring per client spec; everything
  //   else is one-time. Kept as a free string so admins can introduce new
  //   frequencies without a schema change.
  // - qualification: human-readable qualification text (e.g. "Ao fechar o
  //   5º nível", "6 meses de cadastro ativo"). Mirrors the client spec table.
  // - targetValue: for goal-tracking gratifications (e.g. driver daily goal
  //   = 18 rides). Null when not applicable.
  // - currentValue: progress towards targetValue. Null when not applicable.
  frequency    String?   
  qualification String?  
  targetValue  Int?      
  currentValue Int?      
  user         User      @relation(fields: [userId], references: [id])
}

model PointTransaction {
  id          String   @id @default(cuid())
  userId      String
  amount      Int
  type        String
  description String?
  referenceId String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
}

model SystemConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

model WithdrawalRequest {
  id              String    @id @default(cuid())
  userId          String
  amount          Int                          // in cents
  status          String    @default("pending") // pending | approved | rejected | paid | failed
  paymentMethod   String    @default("pix")      // pix | bank_transfer
  pixKey          String?
  bankCode        String?
  bankAgency      String?
  bankAccount     String?
  bankType        String?
  asaasTransferId String?
  asaasStatus     String?                       // status returned by Asaas transfer API
  rejectedReason  String?
  processedById   String?                       // admin who approved/rejected
  processedAt     DateTime?
  paidAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id])
}

model AsaasWebhookEvent {
  id           String   @id @default(cuid())
  eventId      String   @unique                // Asaas event id (idempotency)
  event        String                          // e.g. PAYMENT_RECEIVED, PAYMENT_OVERDUE
  paymentId    String?
  status       String?
  payload      String                          // raw JSON payload
  processed    Boolean  @default(false)
  processedAt  DateTime?
  errorMessage String?
  createdAt    DateTime @default(now())
}

model Announcement {
  id          String    @id @default(cuid())
  title       String
  message     String
  type        String    @default("info")
  priority    String    @default("normal")
  isActive    Boolean   @default(true)
  startDate   DateTime?
  endDate     DateTime?
  actionLabel String?
  actionUrl   String?
  createdBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model GamificationStreak {
  id            String    @id @default(cuid())
  userId        String    @unique
  currentStreak Int       @default(0)
  longestStreak Int       @default(0)
  lastLoginDate DateTime?
  totalPoints   Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id])
}

model Challenge {
  id             String          @id @default(cuid())
  title          String
  description    String
  type           String
  targetValue    Int
  rewardPoints   Int
  isActive       Boolean         @default(true)
  startDate      DateTime?
  endDate        DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  userChallenges UserChallenge[]
}

model UserChallenge {
  id           String    @id @default(cuid())
  userId       String
  challengeId  String
  currentValue Int       @default(0)
  completed    Boolean   @default(false)
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  challenge    Challenge @relation(fields: [challengeId], references: [id])
  user         User      @relation(fields: [userId], references: [id])
}

model Event {
  id            String              @id @default(cuid())
  title         String
  description   String
  type          String
  status        String              @default("upcoming")
  eventDate     DateTime
  endDate       DateTime?
  location      String?
  meetingUrl    String?
  maxAttendees  Int?
  imageUrl      String?
  isActive      Boolean             @default(true)
  createdBy     String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  registrations EventRegistration[]
}

model EventRegistration {
  id           String   @id @default(cuid())
  eventId      String
  userId       String
  registeredAt DateTime @default(now())
  event        Event    @relation(fields: [eventId], references: [id])

  @@unique([eventId, userId])
}

model Beneficiary {
  id           String   @id @default(cuid())
  userId       String
  name         String
  cpf          String?
  relationship String
  percentage   Int
  age          Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id])
}

model MarketplaceProduct {
  id              String                 @id @default(cuid())
  name            String
  description     String?
  price           Int
  originalPrice   Int?
  category        String
  imageUrl        String?
  images          String?
  stock           Int                    @default(0)
  isActive        Boolean                @default(true)
  isFeatured      Boolean                @default(false)
  cashbackPercent Float                  @default(0)
  rating          Float                  @default(0)
  reviewCount     Int                    @default(0)
  sellerName      String?
  tags            String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  orderItems      MarketplaceOrderItem[]
}

model MarketplaceOrder {
  id              String                 @id @default(cuid())
  userId          String
  status          String                 @default("pending")
  totalAmount     Int
  cashbackEarned  Int                    @default(0)
  shippingAddress String?
  paymentMethod   String?
  paidAt          DateTime?
  shippedAt       DateTime?
  deliveredAt     DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  user            User                   @relation(fields: [userId], references: [id])
  items           MarketplaceOrderItem[]
}

model MarketplaceOrderItem {
  id              String             @id @default(cuid())
  orderId         String
  productId       String
  userId          String
  productName     String
  quantity        Int                @default(1)
  unitPrice       Int
  cashbackPercent Float              @default(0)
  createdAt       DateTime           @default(now())
  order           MarketplaceOrder   @relation(fields: [orderId], references: [id])
  product         MarketplaceProduct @relation(fields: [productId], references: [id])
  user            User               @relation(fields: [userId], references: [id])
}

model Plan {
  id                                           String      @id
  code                                         String      @unique
  name                                         String
  priceCents                                   Int         @default(0)
  description                                  String?
  features                                     String      @default("[]")
  isActive                                     Boolean     @default(true)
  isDefault                                    Boolean     @default(false)
  sortOrder                                    Int         @default(0)
  matrixEntradaId                              String?
  matrixResidualId                             String?
  matrixVendasId                               String?
  createdAt                                    DateTime    @default(now())
  updatedAt                                    DateTime    @updatedAt
  MatrixType_Plan_matrixEntradaIdToMatrixType  MatrixType? @relation("Plan_matrixEntradaIdToMatrixType", fields: [matrixEntradaId], references: [id])
  MatrixType_Plan_matrixResidualIdToMatrixType MatrixType? @relation("Plan_matrixResidualIdToMatrixType", fields: [matrixResidualId], references: [id])
  MatrixType_Plan_matrixVendasIdToMatrixType   MatrixType? @relation("Plan_matrixVendasIdToMatrixType", fields: [matrixVendasId], references: [id])
  User                                         User[]
}

model AccreditedNetworkItem {
  id              String   @id
  name            String
  category        String   @default("posto")
  brand           String?
  city            String
  state           String
  address         String?
  phone           String?
  discountText    String?
  cashbackPercent Float    @default(0)
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime

  @@index([brand])
  @@index([category])
  @@index([state])
}

model DiscountClubPartner {
  id              String   @id
  name            String
  logoUrl         String?
  category        String   @default("geral")
  discountText    String?
  cashbackPercent Float    @default(0)
  description     String?
  websiteUrl      String?
  phone           String?
  isActive        Boolean  @default(true)
  isFeatured      Boolean  @default(false)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime
}

model MatrixLevelEarning {
  id              String     @id
  matrixTypeId    String
  level           Int
  percentage      Float      @default(0)
  fixedBonusCents Int        @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime
  MatrixType      MatrixType @relation(fields: [matrixTypeId], references: [id], onDelete: Cascade)

  @@unique([matrixTypeId, level])
}

model MatrixType {
  id                                     String               @id
  code                                   String               @unique
  name                                   String
  matrixKind                             String
  width                                  Int                  @default(4)
  depth                                  Int                  @default(5)
  description                            String?
  color                                  String?
  isActive                               Boolean              @default(true)
  createdAt                              DateTime             @default(now())
  updatedAt                              DateTime
  MatrixLevelEarning                     MatrixLevelEarning[]
  Plan_Plan_matrixEntradaIdToMatrixType  Plan[]               @relation("Plan_matrixEntradaIdToMatrixType")
  Plan_Plan_matrixResidualIdToMatrixType Plan[]               @relation("Plan_matrixResidualIdToMatrixType")
  Plan_Plan_matrixVendasIdToMatrixType   Plan[]               @relation("Plan_matrixVendasIdToMatrixType")
}

model TalkMobiPlan {
  id            String   @id
  name          String
  dataAmount    String
  priceCents    Int
  cashbackCents Int      @default(0)
  rewardPoints  Int      @default(0)
  description   String?
  features      String   @default("[]")
  isPopular     Boolean  @default(false)
  isRecommended Boolean  @default(false)
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Achievement {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  icon        String?
  category    String   @default("general")
  pointsReward Int     @default(0)
  targetValue Int      @default(1)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CareerPlan {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String
  description  String?
  minPoints    Int      @default(0)
  bonusCents   Int      @default(0)
  color        String?
  icon         String?
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model StreakReward {
  id           String   @id @default(cuid())
  streakDays   Int
  rewardType   String   @default("points")
  rewardAmount Int      @default(0)
  description  String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([streakDays])
}

model FAQ {
  id          String   @id @default(cuid())
  question    String
  answer      String
  category    String   @default("geral")
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model GameConfig {
  id              String   @id @default(cuid())
  gameCode        String   @unique
  name            String
  description     String?
  pointsPerWin    Int      @default(10)
  pointsPerPlay   Int      @default(1)
  cashbackPerWin  Int      @default(0)
  minBetCents     Int      @default(0)
  maxPlaysPerDay  Int      @default(10)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// KYC document uploads (Task 14-A / 16-A)
// A user uploads 5 documents (CNH frente/verso, RG frente/verso, comprovante).
// Admin reviews and approves/rejects. Account is blocked from withdrawals,
// cashback claims, and plan upgrades until kycStatus === 'approved'.
// ─────────────────────────────────────────────────────────────────────────────
model KycDocument {
  id          String   @id @default(cuid())
  userId      String
  docType     String   // 'cnh_front' | 'cnh_back' | 'rg_front' | 'rg_back' | 'proof_of_address'
  fileUrl     String
  fileName    String?
  fileSize    Int?
  mimeType    String?
  status      String   @default("pending") // 'pending' | 'approved' | 'rejected'
  reviewedById String?
  reviewedAt  DateTime?
  rejectReason String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, docType])
  @@index([userId])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
// Audit log (Task 14-D)
// Records admin actions for compliance: who did what, when, from where.
// ─────────────────────────────────────────────────────────────────────────────
model AuditLog {
  id          String   @id @default(cuid())
  userId      String?  // admin who performed the action
  action      String   // e.g. 'user.edit', 'kyc.approve', 'withdrawal.approve'
  entityType  String?  // 'User', 'Invoice', 'WithdrawalRequest', etc.
  entityId    String?
  details     String?  // JSON string with before/after or extra context
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Telemedicina activation requests
// Users who want to activate the Telemedicina service submit a request with
// their personal info + dependents. Admin reviews and either approves (then
// sends activation instructions: link/code/credentials) or rejects with notes.
// ─────────────────────────────────────────────────────────────────────────────
model TelemedicinaRequest {
  id              String   @id @default(cuid())
  userId          String
  // Holder (titular) info captured at request time
  fullName        String
  cpf             String
  birthDate       String?
  phone           String
  email           String
  // JSON array of dependents: [{ name, kinship, birthDate, cpf? }]
  dependents      String   @default("[]")
  // Optional medical notes the user wants the admin/provider to know
  notes           String?
  // Status: 'pending' | 'approved' | 'rejected' | 'cancelled'
  status          String   @default("pending")
  // Admin fields (filled on approval / rejection)
  adminNotes      String?
  activationLink  String?  // link/code sent to the user when approved
  approvedById    String?
  approvedAt      DateTime?
  rejectedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}
